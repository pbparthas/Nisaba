{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nisaba",
  "version": "1.0.0",
  "identifier": "dev.orionforge.nisaba",
  "build": {
    "beforeDevCommand": "cd ../app && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../app && npm install && npm run build",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Productivity",
    "shortDescription": "Notes & tasks synced through your own Google Drive",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
